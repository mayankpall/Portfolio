---
import Base from '../layouts/Base.astro';
import Motion from '../components/Motion.astro';
import Contact from '../components/Contact.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { achievements } from '../data/achievements';
import leetcode from '../data/leetcode.json';

/**
 * Each `data-act` section is one beat of the scroll timeline that drives the
 * WebGL stage (see src/lib/scroll.ts). Their order and their real heights are
 * the animation's clock — reordering them reorders the story.
 */

const manifesto = [
  {
    kicker: 'The work',
    line: 'I build products end to end, and I ship them.',
    body: `Most of my time goes to RecurTrack — a recurring-payments app for Indian
      households. React Native and TypeScript on the front, Python behind it, currently
      in App Store review.`,
  },
  {
    kicker: 'The interesting part',
    line: 'The best decision in it was a constraint.',
    body: `RecurTrack never holds, receives, or moves money. Payments flow directly between
      two people's own UPI apps. That keeps it outside RBI's Payment Aggregator framework —
      and it shaped every screen in the product.`,
  },
  {
    kicker: 'The habit',
    line: 'I reduce messy problems to clean shapes.',
    body: `Rank 35 of 24,000 on CodeChef is not a job qualification. But the habit behind it
      is the same one that keeps production code small, and keeps money maths and billing
      cycles correct under test.`,
  },
];
---

<Base>
  <!-- ==================== ACT 0 — HERO ==================== -->
  <section class="hero" id="top" data-act="hero">
    <div class="wrap hero__inner">
      <p class="hero__status line-mask">
        <span>
          {profile.status.available && <i class="dot" aria-hidden="true"></i>}
          {profile.status.label}
        </span>
      </p>

      <h1 class="display hero__title">
        <span class="line-mask"><span>Mayank</span></span>
        <span class="line-mask" style="--reveal-delay:90ms">
          <span>Pal<i class="hero__stop"></i></span>
        </span>
      </h1>

      <div class="hero__foot">
        <p class="hero__role line-mask" style="--reveal-delay:180ms">
          <span>{profile.role}</span>
        </p>
        <p class="hero__pitch reveal" style="--reveal-delay:260ms">
          {profile.positioning}
        </p>
      </div>
    </div>

    <a class="hero__scroll" href="#work" aria-label="Scroll to content">
      <span class="eyebrow">Scroll</span>
      <span class="hero__scroll-line" aria-hidden="true"></span>
    </a>
  </section>

  <!-- ==================== ACT 1 — MANIFESTO (pinned) ====================
       A tall container with a sticky inner panel. Scroll progress cross-fades
       the copy while the stage behind it shatters. This is the Apple
       product-page beat. -->
  <section class="manifesto" id="about" data-act="manifesto" data-pinned={manifesto.length}>
    <div class="manifesto__sticky">
      <div class="wrap">
        {
          manifesto.map((m, i) => (
            <article class="panel" data-panel={i}>
              <p class="eyebrow panel__kicker">{m.kicker}</p>
              <p class="h2 panel__line">{m.line}</p>
              <p class="panel__body">{m.body}</p>
            </article>
          ))
        }
      </div>

      <!-- Progress through the pinned beat, so the scroll never feels stuck. -->
      <div class="manifesto__ticks" aria-hidden="true">
        {manifesto.map((_, i) => <span data-tick={i} />)}
      </div>
    </div>
  </section>

  <!-- ==================== ACT 2 — WORK ==================== -->
  <section class="section work" id="work" data-act="work">
    <div class="wrap">
      <hr class="rule reveal" />
      <header class="sect__head">
        <p class="eyebrow reveal">01 — Selected work</p>
        <h2 class="h2 reveal" style="--reveal-delay:80ms">
          Four things I<br /><span class="italic accent">shipped</span>.
        </h2>
      </header>

      <ol class="work__list">
        {
          projects.map((p, i) => (
            <li class="reveal" style={`--reveal-delay:${i * 70}ms`}>
              <a class="proj" href={`/work/${p.slug}`}>
                <span class="proj__index eyebrow">{p.index}</span>
                <span class="proj__main">
                  <span class="proj__title h3">{p.title}</span>
                  <span class="proj__summary">{p.summary}</span>
                  <span class="proj__stack">
                    {p.stack.slice(0, 5).map((s) => (
                      <span class="chip">{s}</span>
                    ))}
                  </span>
                </span>
                <span class="proj__meta">
                  <span class="proj__year">{p.year}</span>
                  <span class="proj__go" aria-hidden="true">↗</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>

      <!-- The stack table lives here, where it reads as evidence for the work
           above rather than as a decontextualised skills list. -->
      <dl class="stack reveal">
        {
          profile.stack.map((group) => (
            <div class="stack__row">
              <dt class="eyebrow">{group.label}</dt>
              <dd>{group.items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ==================== ACT 3 — PROOF ==================== -->
  <section class="section" id="proof" data-act="proof">
    <div class="wrap">
      <hr class="rule reveal" />
      <header class="sect__head">
        <p class="eyebrow reveal">02 — Proof</p>
        <h2 class="h2 reveal" style="--reveal-delay:80ms">Receipts.</h2>
      </header>

      <ul class="proof">
        {
          achievements.map((a, i) => {
            const Tag = a.href ? 'a' : 'div';
            return (
              <li class="reveal" style={`--reveal-delay:${i * 70}ms`}>
                <Tag
                  class="proof__card"
                  href={a.href}
                  target={a.href ? '_blank' : undefined}
                  rel={a.href ? 'noopener noreferrer' : undefined}
                >
                  <span class="proof__value display">
                    {a.value}
                    {a.unit && <sup class="proof__unit">{a.unit}</sup>}
                  </span>
                  <span class="proof__label h3">{a.label}</span>
                  <span class="proof__detail">{a.detail}</span>
                  {a.href && (
                    <span class="proof__go eyebrow" aria-hidden="true">
                      Verify ↗
                    </span>
                  )}
                </Tag>
              </li>
            );
          })
        }
      </ul>

      <!-- Fetched at build time, baked into this HTML. No client request. -->
      {
        leetcode.total > 0 && (
          <div class="lc reveal">
            <div class="lc__head">
              <p class="eyebrow">LeetCode</p>
              <a class="lc__link" href={profile.links.leetcode} target="_blank" rel="noopener noreferrer">
                @mayankpall ↗
              </a>
            </div>
            <div class="lc__body">
              <p class="lc__total display">{leetcode.total}</p>
              <div class="lc__split">
                <div class="lc__seg">
                  <span class="lc__n">{leetcode.easy}</span>
                  <span class="eyebrow">Easy</span>
                </div>
                <div class="lc__seg">
                  <span class="lc__n">{leetcode.medium}</span>
                  <span class="eyebrow">Medium</span>
                </div>
                <div class="lc__seg">
                  <span class="lc__n">{leetcode.hard}</span>
                  <span class="eyebrow">Hard</span>
                </div>
              </div>
              <div class="lc__bar" aria-hidden="true">
                <span style={`width:${(leetcode.easy / leetcode.total) * 100}%`} data-d="e" />
                <span style={`width:${(leetcode.medium / leetcode.total) * 100}%`} data-d="m" />
                <span style={`width:${(leetcode.hard / leetcode.total) * 100}%`} data-d="h" />
              </div>
              <p class="lc__note">
                Problems solved. Updated automatically on every deploy
                {leetcode.fetchedAt && ` — last read ${leetcode.fetchedAt}`}.
              </p>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- ==================== ACT 4 — CONTACT ==================== -->
  <Contact />

  <Motion />
</Base>

<script>
  /**
   * Drives the pinned manifesto panels from the same timeline as the stage,
   * so copy and 3D are never a frame out of sync.
   *
   * Only one panel is readable at a time; the others are faded AND
   * `visibility: hidden` so screen readers and tab order do not walk through
   * three overlapping paragraphs.
   */
  import { onScroll, smooth, clamp } from '../lib/scroll';

  const acts = Array.from(document.querySelectorAll<HTMLElement>('[data-act]'));
  const section = document.querySelector<HTMLElement>('[data-pinned]');

  if (section) {
    const actIndex = acts.indexOf(section);
    const sticky = section.querySelector<HTMLElement>('.manifesto__sticky')!;
    const panels = Array.from(section.querySelectorAll<HTMLElement>('[data-panel]'));
    const ticks = Array.from(section.querySelectorAll<HTMLElement>('[data-tick]'));
    const n = panels.length;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduced) {
      // No pinning, no cross-fade: the panels simply stack and read as prose.
      section.classList.add('is-static');
    } else {
      onScroll(({ t }) => {
        // Local progress through this act, 0 to 1.
        const p = clamp(t - actIndex);

        // A triangular window per panel, centred on its slice. Clamping the
        // read-head to [0.5, n-0.5] holds the first and last panels open at
        // the edges instead of fading them to nothing before the act begins.
        //
        // The windows are sized so neighbours reach zero at the boundary
        // between them: at no point are two paragraphs legible at once, which
        // is what made the earlier version read as a double exposure.
        const head = Math.min(Math.max(p * n, 0.5), n - 0.5);

        // Fade the whole stack in at the start and out before the section
        // releases, so the pinned copy never collides with what follows.
        sticky.style.opacity = (
          smooth(clamp(p / 0.05)) * (1 - smooth(clamp((p - 0.86) / 0.14)))
        ).toFixed(3);

        panels.forEach((panel, i) => {
          const d = Math.abs(head - (i + 0.5));
          const o = smooth(clamp(1 - (d - 0.16) / 0.3));

          panel.style.opacity = o.toFixed(3);
          panel.style.transform = `translate3d(0, ${((1 - o) * 30).toFixed(1)}px, 0)`;
          panel.style.visibility = o < 0.02 ? 'hidden' : 'visible';
          // Only the legible panel is exposed to assistive tech and tab order.
          panel.setAttribute('aria-hidden', o < 0.5 ? 'true' : 'false');
          panel.style.pointerEvents = o < 0.5 ? 'none' : 'auto';
        });

        ticks.forEach((tick, i) => {
          const active = p >= i / n && p < (i + 1) / n;
          tick.dataset.on = active ? 'true' : 'false';
        });
      });
    }
  }
</script>

<style>
  /* ==================== HERO ==================== */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: 8rem 4rem;
  }

  .hero__inner {
    position: relative;
  }

  .hero__status {
    margin-bottom: clamp(2rem, 8vh, 5rem);
  }
  .hero__status span {
    font-family: var(--mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ember);
    display: inline-block;
    flex: none;
    animation: pulse 2.6s var(--ease) infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(198, 80, 45, 0.5); }
    70% { box-shadow: 0 0 0 9px rgba(198, 80, 45, 0); }
    100% { box-shadow: 0 0 0 0 rgba(198, 80, 45, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot { animation: none; }
  }

  .hero__title {
    margin-bottom: clamp(2rem, 6vh, 4rem);
  }

  /* The full stop is the accent's first appearance. It earns its place. */
  .hero__stop {
    display: inline-block;
    width: 0.11em;
    height: 0.11em;
    border-radius: 50%;
    background: var(--ember);
    margin-left: 0.06em;
  }

  .hero__foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    border-top: 1px solid var(--rule);
    padding-top: 1.75rem;
  }

  .hero__role span {
    font-family: var(--mono);
    font-size: var(--t-small);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--paper);
  }

  .hero__pitch {
    color: var(--muted);
    max-width: 46ch;
    font-size: clamp(0.95rem, 1.1vw, 1.08rem);
  }

  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    right: var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .hero__scroll-line {
    width: 1px;
    height: 54px;
    background: linear-gradient(to bottom, var(--rule-strong), transparent);
    position: relative;
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 40%;
    background: var(--ember);
    animation: trace 2.4s var(--ease) infinite;
  }
  @keyframes trace {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(250%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line::after { animation: none; opacity: 0.4; }
  }

  @media (max-width: 860px) {
    .hero__foot {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1rem;
    }
    .hero__scroll { display: none; }
  }

  /* ==================== MANIFESTO (pinned) ==================== */
  .manifesto {
    /* Tall enough to give each panel real scroll distance. Three panels want
       roughly one viewport each, plus a little lead-in and lead-out. */
    height: 360vh;
    position: relative;
  }

  .manifesto__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Panels stack in the same grid cell and cross-fade. */
  .manifesto__sticky .wrap {
    display: grid;
  }
  .panel {
    grid-area: 1 / 1;
    max-width: 22ch;
    will-change: opacity, transform;
  }

  .panel__kicker {
    margin-bottom: 1.5rem;
  }
  .panel__line {
    margin-bottom: 1.75rem;
  }
  .panel__body {
    max-width: 46ch;
    color: var(--muted);
    font-size: clamp(0.98rem, 1.15vw, 1.12rem);
    line-height: 1.65;
  }

  .manifesto__ticks {
    position: absolute;
    left: var(--gutter);
    bottom: 3.5rem;
    display: flex;
    gap: 0.5rem;
  }
  .manifesto__ticks span {
    width: 34px;
    height: 2px;
    background: var(--rule-strong);
    transition: background var(--dur-fast) var(--ease);
  }
  .manifesto__ticks span[data-on='true'] {
    background: var(--ember);
  }

  /* Reduced motion, or no JS: unpin and let the panels read as prose. */
  .manifesto.is-static,
  html:not(.js) .manifesto {
    height: auto;
  }
  .manifesto.is-static .manifesto__sticky,
  html:not(.js) .manifesto .manifesto__sticky {
    position: static;
    height: auto;
    padding-block: var(--section);
  }
  .manifesto.is-static .manifesto__sticky .wrap,
  html:not(.js) .manifesto .manifesto__sticky .wrap {
    display: block;
  }
  .manifesto.is-static .panel,
  html:not(.js) .manifesto .panel {
    max-width: var(--measure);
  }
  .manifesto.is-static .panel + .panel,
  html:not(.js) .manifesto .panel + .panel {
    margin-top: 3.5rem;
  }
  .manifesto.is-static .manifesto__ticks,
  html:not(.js) .manifesto .manifesto__ticks {
    display: none;
  }

  @media (max-width: 860px) {
    .manifesto { height: 320vh; }
    .panel { max-width: none; }
    .panel__line { max-width: 14ch; }
  }

  /* ==================== SECTION HEADS ==================== */
  .sect__head {
    padding-top: 3rem;
    margin-bottom: clamp(2.5rem, 7vh, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }
  @media (max-width: 1000px) {
    .sect__head { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  /* ==================== WORK ==================== */
  .work__list {
    list-style: none;
  }

  .proj {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) 7rem;
    gap: clamp(1rem, 3vw, 3rem);
    padding-block: clamp(1.75rem, 4vh, 2.75rem);
    border-top: 1px solid var(--rule);
    align-items: start;
    position: relative;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .work__list li:last-child .proj {
    border-bottom: 1px solid var(--rule);
  }

  /* A wash that wipes in from the left on hover — the row lights up rather
     than lifting. Lifting cards is the template look. */
  .proj::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--gutter) * -0.4);
    background: linear-gradient(90deg, var(--ember-soft), transparent 70%);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease);
    pointer-events: none;
  }
  .proj:hover::before,
  .proj:focus-visible::before { opacity: 1; }
  .proj:hover { border-color: var(--rule-strong); }

  .proj__index { padding-top: 0.4rem; }

  .proj__title {
    display: block;
    transition: transform var(--dur-fast) var(--ease);
  }
  .proj:hover .proj__title { transform: translateX(6px); }

  .proj__summary {
    display: block;
    color: var(--muted);
    margin-top: 0.5rem;
    max-width: 52ch;
    font-size: var(--t-small);
  }

  .proj__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }
  .chip {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-dim);
    border: 1px solid var(--rule);
    padding: 0.25rem 0.55rem;
    border-radius: 2px;
  }

  .proj__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--mono);
    font-size: var(--t-micro);
    color: var(--muted-dim);
    padding-top: 0.4rem;
  }
  .proj__go {
    font-size: 1rem;
    transition: transform var(--dur-fast) var(--ease);
  }
  .proj:hover .proj__go {
    transform: translate(3px, -3px);
    color: var(--ember);
  }

  @media (max-width: 720px) {
    .proj { grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; }
    .proj__meta {
      grid-column: 2;
      justify-content: flex-start;
      gap: 1.5rem;
      padding-top: 0.75rem;
    }
  }

  /* ==================== STACK ==================== */
  .stack {
    margin-top: clamp(3rem, 8vh, 5rem);
    columns: 2;
    column-gap: clamp(2rem, 5vw, 4rem);
  }
  .stack__row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
    break-inside: avoid;
  }
  .stack__row dd {
    font-size: var(--t-small);
    color: var(--muted);
    line-height: 1.7;
  }
  @media (max-width: 860px) {
    .stack { columns: 1; }
  }
  @media (max-width: 520px) {
    .stack__row { grid-template-columns: 1fr; gap: 0.35rem; }
  }

  /* ==================== PROOF ==================== */
  .proof {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .proof__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    /* Slightly translucent so the stage shows through — the cards sit in the
       scene rather than on top of it. */
    background: rgba(8, 8, 10, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    transition: background var(--dur-fast) var(--ease);
  }
  a.proof__card:hover { background: rgba(20, 20, 24, 0.85); }

  .proof__value {
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 0.9;
    color: var(--paper);
  }
  .proof__unit {
    font-size: 0.34em;
    vertical-align: super;
    color: var(--ember);
    margin-left: 0.04em;
  }

  .proof__label { margin-top: 1.5rem; font-size: 1rem; }
  .proof__detail {
    margin-top: 0.4rem;
    font-size: var(--t-small);
    color: var(--muted);
    flex: 1;
  }
  .proof__go {
    margin-top: 1.25rem;
    color: var(--muted-dim);
    transition: color var(--dur-fast) var(--ease);
  }
  a.proof__card:hover .proof__go { color: var(--ember); }

  /* ---- LeetCode panel ---- */
  .lc {
    margin-top: 1px;
    border: 1px solid var(--rule);
    border-top: 0;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: rgba(8, 8, 10, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .lc__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .lc__link {
    font-family: var(--mono);
    font-size: var(--t-micro);
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }
  .lc__link:hover { color: var(--ember); }

  .lc__body {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .lc__total {
    font-size: clamp(3.5rem, 8vw, 6rem);
    line-height: 0.85;
    grid-row: span 2;
  }
  .lc__split { display: flex; gap: clamp(1.5rem, 4vw, 3rem); }
  .lc__seg { display: flex; flex-direction: column; gap: 0.2rem; }
  .lc__n {
    font-family: var(--mono);
    font-size: 1.35rem;
    font-weight: 500;
  }

  .lc__bar { display: flex; height: 3px; width: 100%; overflow: hidden; }
  .lc__bar span[data-d='e'] { background: var(--muted); }
  .lc__bar span[data-d='m'] { background: var(--paper); }
  .lc__bar span[data-d='h'] { background: var(--ember); }

  .lc__note {
    grid-column: 2;
