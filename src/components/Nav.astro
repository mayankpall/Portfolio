---
import { profile } from '../data/profile';

interface Props {
  back?: boolean;
}
const { back = false } = Astro.props;

const items = [
  { label: 'Work', href: '/#work' },
  { label: 'Approach', href: '/#approach' },
  { label: 'Proof', href: '/#proof' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="nav" data-nav>
  <div class="wrap nav__inner">
    <a class="nav__mark" href="/" aria-label={`${profile.name} — home`}>
      {back ? <span class="nav__back" aria-hidden="true">←</span> : null}
      <span class="nav__mark-text">{profile.name}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav__list">
        {
          items.map((item) => (
            <li>
              <a class="nav__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="nav__link nav__link--cv" href={profile.resume} target="_blank" rel="noopener">
            CV<span class="sr-only"> (PDF, opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="nav__progress" aria-hidden="true"><span data-progress></span></div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 90;
    padding-block: 1.35rem;
    transition:
      background var(--dur-fast) var(--ease),
      backdrop-filter var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
    border-bottom: 1px solid transparent;
  }

  .nav.is-stuck {
    background: rgba(8, 8, 10, 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--rule);
  }

  .nav__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    overflow: hidden;
  }
  .nav__progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--ember);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease);
  }
  .nav.is-stuck .nav__progress span {
    opacity: 1;
  }

  /* Below 640px the four links plus the mark would crowd; the two reachable
     by scrolling anyway drop out. Vertical padding shrinks so a 44px target
     does not inflate the header. */
  @media (max-width: 640px) {
    .nav { padding-block: 0.5rem; }
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav__mark {
    font-family: var(--display);
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .nav__back {
    font-family: var(--sans);
    font-size: 0.95rem;
    color: var(--muted);
    transition: transform var(--dur-fast) var(--ease);
  }
  .nav__mark:hover .nav__back {
    transform: translateX(-3px);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.2vw, 2.25rem);
    list-style: none;
  }

  .nav__link {
    font-family: var(--mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    position: relative;
    /* A 44px hit area. These were 27px tall — above the WCAG 2.2 minimum of
       24px but well below a comfortable thumb target, and they are the
       primary navigation on a phone. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.25rem;
    transition: color var(--dur-fast) var(--ease);
  }

  /* Underline grows from the left rather than fading — reads as deliberate. */
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0.25rem;
    right: 0.25rem;
    bottom: 12px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease);
  }

  .nav__link:hover,
  .nav__link:focus-visible,
  .nav__link[aria-current='true'] {
    color: var(--paper);
  }
  .nav__link:hover::after,
  .nav__link[aria-current='true']::after {
    transform: scaleX(1);
  }
  .nav__link[aria-current='true']::after {
    background: var(--ember);
  }

  .nav__link--cv {
    color: var(--paper);
  }
  .nav__link--cv::after {
    transform: scaleX(1);
    background: var(--rule-strong);
  }
  .nav__link--cv:hover::after {
    background: var(--ember);
  }

  /* Below 640px the mark alone would crowd four links; drop the two
     that are reachable by scrolling anyway. No hamburger, no JS. */
  @media (max-width: 640px) {
    .nav__list li:nth-child(2),
    .nav__list li:nth-child(3) {
      display: none;
    }
    .nav__mark-text {
      font-size: 1rem;
    }
  }
</style>

<script>
  // Reads the shared scroll timeline instead of adding a second listener.
  // The old site ran unthrottled work on every scroll event; everything
  // scroll-driven here shares one rAF loop.
  import { onScroll } from '../lib/scroll';

  const nav = document.querySelector('[data-nav]');
  const progress = document.querySelector<HTMLElement>('[data-progress]');

  // Which nav link corresponds to which act, so the header can say where you
  // are. On an eight-screen page with a pinned act, the progress hairline
  // alone was not enough wayfinding.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav__link'));
  const sections = links
    .map((link) => {
      const hash = link.getAttribute('href')?.split('#')[1];
      return { link, el: hash ? document.getElementById(hash) : null };
    })
    .filter((s): s is { link: HTMLAnchorElement; el: HTMLElement } => !!s.el);

  if (nav) {
    onScroll(({ g }) => {
      nav.classList.toggle('is-stuck', window.scrollY > 24);
      progress?.style.setProperty('--p', g.toFixed(4));

      // The section occupying the upper third of the viewport is the one you
      // are reading; using the very top makes the label flip a beat early.
      const probe = window.scrollY + window.innerHeight * 0.35;
      let current: HTMLAnchorElement | null = null;
      for (const { link, el } of sections) {
        if (probe >= el.offsetTop && probe < el.offsetTop + el.offsetHeight) current = link;
      }
      for (const { link } of sections) {
        if (link === current) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    });
  }
</script>
