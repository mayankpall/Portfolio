---
/**
 * The signature object: a faceted obsidian shard with a clearcoat finish,
 * lit by a bone key light and an ember rim. Abstract on purpose — it sets a
 * mood and then gets out of the typography's way.
 *
 * Written against bare three, with no React and no drei. For a single mesh
 * React Three Fiber earned nothing and cost ~50KB gzip; drei's transmission
 * material cost another ~70KB plus a full render target every frame. The
 * environment map here is generated from a 16-pixel gradient, so it is free
 * and needs no HDR file hosted anywhere.
 *
 * three itself is behind a dynamic import that only ever runs when all of
 * these hold — so phones, reduced-motion users and machines without WebGL
 * never download a byte of it:
 *   · viewport is at least 768px wide
 *   · prefers-reduced-motion is not set
 *   · the canvas has actually scrolled into view
 *   · a WebGL2 context can be created
 *
 * Everything below that is the CSS poster in index.astro, which is the whole
 * artwork on mobile.
 */
---

<div class="hero3d" data-hero3d aria-hidden="true"></div>

<style>
  .hero3d {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Decoration only — text underneath must stay selectable. */
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.4s var(--ease);
  }
  .hero3d.is-live {
    opacity: 1;
  }
  .hero3d :global(canvas) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  const mount = document.querySelector<HTMLElement>('[data-hero3d]');

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wideEnough = window.matchMedia('(min-width: 768px)').matches;

  function hasWebGL(): boolean {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  if (mount && wideEnough && !reduced && hasWebGL()) {
    // Only start loading three once the hero is actually on screen.
    const io = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      io.disconnect();
      init(mount).catch((err) => {
        // Leave the CSS poster in place rather than an empty black box.
        console.warn('[hero3d] falling back to poster:', err);
      });
    });
    io.observe(mount);
  }

  async function init(el: HTMLElement) {
    const THREE = await import('three');

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(42, el.clientWidth / el.clientHeight, 0.1, 100);
    camera.position.set(0, 0, 5.0);

    const renderer = new THREE.WebGLRenderer({
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setSize(el.clientWidth, el.clientHeight);
    // Cap DPR at 2 — beyond that the cost far exceeds what is visible.
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    el.appendChild(renderer.domElement);

    /* ---- Environment map from a 3-stop gradient, via PMREM ---- */
    const W = 16;
    const H = 64;
    const data = new Uint8Array(W * H * 4);
    const key = new THREE.Color('#fafaf8'); // bone key, top
    const mid = new THREE.Color('#2a2a30'); // neutral falloff
    const rim = new THREE.Color('#c6502d'); // ember rim, bottom

    for (let y = 0; y < H; y++) {
      const t = y / (H - 1);
      const c = new THREE.Color();
      if (t < 0.5) c.copy(key).lerp(mid, t * 2);
      else c.copy(mid).lerp(rim, (t - 0.5) * 2);
      for (let x = 0; x < W; x++) {
        const i = (y * W + x) * 4;
        data[i] = c.r * 255;
        data[i + 1] = c.g * 255;
        data[i + 2] = c.b * 255;
        data[i + 3] = 255;
      }
    }

    const gradient = new THREE.DataTexture(data, W, H, THREE.RGBAFormat);
    gradient.mapping = THREE.EquirectangularReflectionMapping;
    gradient.colorSpace = THREE.SRGBColorSpace;
    gradient.needsUpdate = true;

    const pmrem = new THREE.PMREMGenerator(renderer);
    const envMap = pmrem.fromEquirectangular(gradient).texture;
    pmrem.dispose();
    gradient.dispose();

    /* ---- The shard ---- */
    // Detail 0 keeps facets large enough to catch distinct highlights;
    // anything smoother reads as a generic sphere.
    const geometry = new THREE.IcosahedronGeometry(1, 0);
    const material = new THREE.MeshPhysicalMaterial({
      envMap,
      envMapIntensity: 2.6,
      color: new THREE.Color('#2f2b33'),
      metalness: 0.62,
      roughness: 0.26,
      clearcoat: 1,
      clearcoatRoughness: 0.06,
      iridescence: 0.3,
      iridescenceIOR: 1.35,
      flatShading: true,
    });

    const shard = new THREE.Mesh(geometry, material);
    shard.scale.setScalar(1.15);

    // The group carries the composition offset so the mesh can keep
    // animating around its own origin.
    const rig = new THREE.Group();
    rig.add(shard);
    rig.position.set(1.55, 0.25, 0);
    scene.add(rig);

    scene.add(new THREE.AmbientLight(0xffffff, 0.5));

    const keyLight = new THREE.DirectionalLight(0xfafaf8, 4.2);
    keyLight.position.set(-3, 4, 5);
    scene.add(keyLight);

    const rimLight = new THREE.PointLight(0xc6502d, 26, 14);
    rimLight.position.set(4.5, -1.5, 1.5);
    scene.add(rimLight);

    // Cool fill from behind — without it the unlit facets collapse into
    // one another and the whole form reads as a flat silhouette.
    const fillLight = new THREE.PointLight(0x9aa3ab, 7, 14);
    fillLight.position.set(-2.5, -2.5, -3);
    scene.add(fillLight);

    /* ---- Pointer parallax ---- */
    const pointer = { x: 0, y: 0 };
    const onPointerMove = (e: PointerEvent) => {
      pointer.x = (e.clientX / window.innerWidth) * 2 - 1;
      pointer.y = (e.clientY / window.innerHeight) * 2 - 1;
    };
    window.addEventListener('pointermove', onPointerMove, { passive: true });

    /* ---- Resize ---- */
    const onResize = () => {
      const w = el.clientWidth;
      const h = el.clientHeight;
      if (!w || !h) return;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    };
    const ro = new ResizeObserver(onResize);
    ro.observe(el);

    /* ---- Pause when hidden or scrolled past ----
       A render loop running behind another tab is pure battery theft. */
    let visible = true;
    const visIO = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
      },
      { threshold: 0 },
    );
    visIO.observe(el);

    const onVisibility = () => {
      if (!document.hidden) clock.getDelta(); // discard the gap
    };
    document.addEventListener('visibilitychange', onVisibility);

    /* ---- Context loss → poster ---- */
    renderer.domElement.addEventListener('webglcontextlost', (e) => {
      e.preventDefault();
      running = false;
      el.classList.remove('is-live');
    });

    /* ---- Loop ---- */
    const clock = new THREE.Clock();
    let running = true;

    const frame = () => {
      if (!running) return;
      requestAnimationFrame(frame);
      if (!visible || document.hidden) return;

      const delta = Math.min(clock.getDelta(), 0.05);
      const t = clock.elapsedTime;

      // Slow, weighted tumble. Nothing here should ever look springy.
      shard.rotation.y += delta * 0.15;
      shard.rotation.x = Math.sin(t * 0.21) * 0.2;
      shard.position.y = Math.sin(t * 0.48) * 0.09;

      // Lerped so it trails the pointer rather than tracking it.
      shard.rotation.z += (pointer.x * 0.26 - shard.rotation.z) * 0.028;
      shard.position.x += (-pointer.y * 0.12 - shard.position.x) * 0.028;

      renderer.render(scene, camera);
    };

    onResize();
    frame();
    el.classList.add('is-live');
  }
</script>
